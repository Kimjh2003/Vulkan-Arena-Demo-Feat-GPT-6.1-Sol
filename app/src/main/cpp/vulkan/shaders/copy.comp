#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D sourceTexture;
layout(set=0,binding=1,rgba8) uniform writeonly image2D outputTexture;
layout(push_constant) uniform Extent {ivec2 size;} extent;
void main(){ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,extent.size)))return;imageStore(outputTexture,p,texelFetch(sourceTexture,p,0));}
